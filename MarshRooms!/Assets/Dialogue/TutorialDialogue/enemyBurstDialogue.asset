  m_Script: {fileID: 11500000, guid: d396eeaa05b4f404ea49b1f5e4965776, type: 3}
  m_Name: enemyBurstDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Marsh
    portrait: {fileID: 2022291355, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: 2022291355, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: <b><shake>EEEEK!</shake></b> What are you doing in here?!
    voiceClip: {fileID: 8300000, guid: 11b094d6554fc1c4babeb28b850eab64, type: 3}
    typewriterSpeedOverride: 45
  - speakerName: Button
    portrait: {fileID: 6129928870174149246, guid: f121cdb56daa4f047b9dcf64c76adc39, type: 3}
    talkingPortrait: {fileID: -2082532926561297249, guid: f121cdb56daa4f047b9dcf64c76adc39, type: 3}
    text: Hand over the <b>snail</b> kiddo.
    voiceClip: {fileID: 8300000, guid: 50c3146b200e7fb4e8e394d03c65e3b9, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Marsh
    portrait: {fileID: 4452015905900111914, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1870950988, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: '<b>NO!</b> Stay back, I''m warning you... '
    voiceClip: {fileID: 8300000, guid: eef9789cceb98a94c85314548f3e2021, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Marsh
    portrait: {fileID: 4452015905900111914, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1870950988, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: 'I have a <b><shake>plunger</shake></b> and I''m not afraid to use it! '
    voiceClip: {fileID: 8300000, guid: 03fd7ef7a9b872447b8c7209c0fc50b3, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Button
    portrait: {fileID: 6129928870174149246, guid: f121cdb56daa4f047b9dcf64c76adc39, type: 3}
    talkingPortrait: {fileID: -2082532926561297249, guid: f121cdb56daa4f047b9dcf64c76adc39, type: 3}
    text: You asked for it...
    voiceClip: {fileID: 8300000, guid: 4863f435f34e42f4cbd5d2305ed3ab8b, type: 3}
    typewriterSpeedOverride: 0

  lines:
  - speakerName: Marsh
    portrait: {fileID: 5355775165517145425, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: 6562647036115510444, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Ahhh what a wonderful day!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
  - speakerName: Marsh
    portrait: {fileID: 5355775165517145425, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: 6562647036115510444, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: <b>Truffle Town</b> has never been so perfectly moist.
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
  - speakerName: Marsh
    portrait: {fileID: -329717952, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -857384039, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: I'm sure nothing tragic will happen today, I can feel it in my spores.
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
  - speakerName: Mr. Blobs
    portrait: {fileID: 1017824340, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: 1749068291, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: Blerp. Squirp. Meep.
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 15
  - speakerName: Marsh
    portrait: {fileID: -494353170450514161, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1126149774, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: 'What''s that <b>Mr. Blobs</b>? The toilet is clogged... <shake>AGAIN</shake>! '
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
  - speakerName: Mr. Blobs
    portrait: {fileID: 1017824340, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: 1749068291, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: Mlurp!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 20
  - speakerName: Marsh
    portrait: {fileID: -329717952, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: 6562647036115510444, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Don't worry, I got it!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0

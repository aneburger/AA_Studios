  lines:
  - speakerName: Marsh
    portrait: {fileID: -916550197, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1472452136, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Look Mr. Blobs, I have a <shake><b>plunger</b></shake>!
    voiceClip: {fileID: 8300000, guid: 415db3166102eff478ce7f254974ab27, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Mr. Blobs
    portrait: {fileID: -1425304026, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: 166560441, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: Murp. MEEP. Glorp!
    voiceClip: {fileID: 8300000, guid: 820ab871a579ee64bb17ba0d00ead17c, type: 3}
    typewriterSpeedOverride: 20
  - speakerName: Marsh
    portrait: {fileID: 5355775165517145425, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1126149774, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: What? I was on my way to fix it anyway!
    voiceClip: {fileID: 8300000, guid: e8baf8eea7b324a4888e8776093592cd, type: 3}
    typewriterSpeedOverride: 0

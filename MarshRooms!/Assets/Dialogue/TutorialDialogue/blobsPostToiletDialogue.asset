  - speakerName: Mr. Blobs
    portrait: {fileID: 1017824340, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: 1212555847, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: Meep. Mop!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 15
  - speakerName: Marsh
    portrait: {fileID: -916550197, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1472452136, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Now we can spend some quality mushroom-on-snail time together!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
  - speakerName: Mr. Blobs
    portrait: {fileID: 1017824340, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: -1224400765, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: Barp. Baaarp!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 15
  - speakerName: Marsh
    portrait: {fileID: -329717952, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -857384039, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Ya know, your my bestest friend in the whole world!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
  - speakerName: Marsh
    portrait: {fileID: -4332381428540570747, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1126149774, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}

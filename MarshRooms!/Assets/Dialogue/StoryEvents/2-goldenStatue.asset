    talkingPortrait: {fileID: 63140439, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Hah, why is his head so <shake>MASSIVE</shake>?
    voiceClip: {fileID: 8300000, guid: 661def0fbf008564a8c3fafcdc346ea5, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: ???
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: HEY I HEARD THAT!
    voiceClip: {fileID: 8300000, guid: 0da7137c118f2d54fb655a50fdf8ac11, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Marsh

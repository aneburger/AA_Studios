    talkingPortrait: {fileID: 2022291355, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Woah, it's a talking statue!
    voiceClip: {fileID: 8300000, guid: b544e02ded30b934aa493eb51d39796f, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: ???
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: ' NO YOU SPORE HEAD! Down here, the speaker!'
    voiceClip: {fileID: 8300000, guid: 85dee9f9332640c4fa57f6f71ee005b0, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: ???

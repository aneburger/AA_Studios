  lines:
  - speakerName: Marsh
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: ' It''s you again! Why are you in here?'
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: ' I burnt the Escargot sauce... it''s a <shake>crime</shake>'
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Marsh
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: 'Escargot?! Have you seen Mr. Blobs?!

'
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: 'Oh, the little snail? Yeah, he was in here a few minutes ago.

'
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Marsh
    portrait: {fileID: 0}
    talkingPortrait: {fileID: 0}
    text: 'The guards took him upstairs for... <i>inspection</i>.

'
    voiceClip: {fileID: 0}

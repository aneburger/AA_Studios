  lines:
  - speakerName: Marsh
    portrait: {fileID: -4332381428540570747, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1126149774, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: ' It''s you again! Why are you in here?'
    voiceClip: {fileID: 8300000, guid: 541d8c0e5897f244898d1d1e640146cf, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: -4838557198409533639, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    talkingPortrait: {fileID: 2407537348783464230, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    text: ' I burnt the Escargot sauce... it''s a <shake>crime</shake>.'
    voiceClip: {fileID: 8300000, guid: b55a99576a2b0f8499fb9e9f7dd61be7, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Marsh
    portrait: {fileID: -1126149774, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: 2022291355, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: 'Escargot?! Have you seen Mr. Blobs?!

'
    voiceClip: {fileID: 8300000, guid: 6ef152dd5ecc2bb44a339ab2169faf7e, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: 340477114914435048, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    talkingPortrait: {fileID: 2407537348783464230, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    text: 'Oh, the little snail? Yeah, he was in here a few minutes ago.

'
    voiceClip: {fileID: 8300000, guid: 426cccb3c29772f48b20782a6462b54c, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: 340477114914435048, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    talkingPortrait: {fileID: 2407537348783464230, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    text: The guards took him upstairs for... <shake><i>inspection</i></shake>
    voiceClip: {fileID: 8300000, guid: 05c744b3e69a8114ab93e045b0aa02a3, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0

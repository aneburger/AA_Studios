  lines:
  - speakerName: Chef Puffs
    portrait: {fileID: -3127762171316729299, guid: 2da342deb6060304594530c431c490c0, type: 3}
    talkingPortrait: {fileID: -7808003101643997847, guid: 2da342deb6060304594530c431c490c0, type: 3}
    text: Ah, <i>petit champignon</i>, I am surprised you made it this far.
    voiceClip: {fileID: 8300000, guid: d11c2608976e6bb4091937e46ea90930, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Marsh
    portrait: {fileID: 1730539990, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1870950988, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: Where are you hiding Mr. Blobs?!
    voiceClip: {fileID: 8300000, guid: eef9789cceb98a94c85314548f3e2021, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Chef Puffs
    portrait: {fileID: -6685546810934331548, guid: 2da342deb6060304594530c431c490c0, type: 3}
    talkingPortrait: {fileID: -8512850532406554754, guid: 2da342deb6060304594530c431c490c0, type: 3}
    text: <i>Oh la la</i>! Such feistiness, but alas it is all in vain...
    voiceClip: {fileID: 8300000, guid: 435a9985f00e26d42bea05d8a5437703, type: 3}
    typewriterSpeedOverride: 0

  lines:
  - speakerName: Marsh
    portrait: {fileID: -4332381428540570747, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: -1126149774, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: It's.. just a crusty croissant.
    voiceClip: {fileID: 8300000, guid: e408e3b7c242b734a9af8c45928882ac, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Chef Puffs
    portrait: {fileID: 177564928, guid: 2da342deb6060304594530c431c490c0, type: 3}
    talkingPortrait: {fileID: 1051131276, guid: 2da342deb6060304594530c431c490c0, type: 3}
    text: <b>CRUSTY?</b>
    voiceClip: {fileID: 8300000, guid: 4ee610ac65c91ce42950b901de0a6857, type: 3}
    typewriterSpeedOverride: 0
  - speakerName: Chef Puffs
    portrait: {fileID: -3127762171316729299, guid: 2da342deb6060304594530c431c490c0, type: 3}
    talkingPortrait: {fileID: 0}
    text: <i><b>NON</b></i>! It is my <i>piece de resistance!</i> It will make your
      dodges more...<shake><i>formidable!</i></shake>
    voiceClip: {fileID: 8300000, guid: 435a9985f00e26d42bea05d8a5437703, type: 3}
    typewriterSpeedOverride: 0

  lines:
  - speakerName: Pres. Portobello
    portrait: {fileID: 5322633849160142261, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    talkingPortrait: {fileID: -7861785490601128456, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    text: You dare stand before the great <b>PRESIDENT PORTOBELLO</b>?!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Pres. Portobello
    portrait: {fileID: 3144679132441099472, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    talkingPortrait: {fileID: 3144679132441099472, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    text: The most handsome! Most powerful! Most -
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Marsh
    portrait: {fileID: -1990452341, guid: 2103e7576939ef846a548a3144909d23, type: 3}
    talkingPortrait: {fileID: -2095370656, guid: 2103e7576939ef846a548a3144909d23, type: 3}
    text: Can I have my snail back now?
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Pres. Portobello
    portrait: {fileID: -4656897530138824443, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    talkingPortrait: {fileID: -9178681478427425499, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    text: How <shake>DARE</shake> you interrupt my monologue!
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mr. Blobs
    portrait: {fileID: 1749068291, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: 1212555847, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: <shake>MLEE!</shake>
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Pres. Portobello
    portrait: {fileID: -4656897530138824443, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    talkingPortrait: {fileID: -9178681478427425499, guid: da9a0b2b89f807e4fbdcbb2057c0451e, type: 3}
    text: '<b>SILENCE!</b> No one ruins MY dinner!

'
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0

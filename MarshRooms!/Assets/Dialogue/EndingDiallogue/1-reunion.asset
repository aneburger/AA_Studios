  - speakerName: Marsh
    portrait: {fileID: -2681918893553572030, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    talkingPortrait: {fileID: 6562647036115510444, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}
    text: "I'd hug you now, but we don't have any arms\u2026 "

  - speakerName: Marsh
    portrait: {fileID: -2681918893553572030, guid: 2103e7576939ef846a548a3144909d23, type: 3}
    talkingPortrait: {fileID: -857384039, guid: 96f423fd58af20743ab60c2815e095a2, type: 3}

  - speakerName: Mr. Blobs
    portrait: {fileID: -1425304026, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    talkingPortrait: {fileID: 1138976220, guid: c829638a635bcaa45b342d27f05bca54, type: 3}
    text: ' Mleeerp! '
    voiceClip: {fileID: 0}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0

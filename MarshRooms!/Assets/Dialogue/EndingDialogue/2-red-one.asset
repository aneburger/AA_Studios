  lines:
  - speakerName: Mycena
    portrait: {fileID: 1693693705591843229, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    talkingPortrait: {fileID: -3164252959427007010, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    text: 'Look, everyone! It''s the <i>Red One</i>! '
    voiceClip: {fileID: 8300000, guid: 0012a3e1b330aff4188f7fcbe4edf7c0, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: 3005716926295572500, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    talkingPortrait: {fileID: -8547339893586726025, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    text: He freed us from the big-headed tyrant!
    voiceClip: {fileID: 8300000, guid: 55ace30a4ac6e4f4bbd754f0ba63e34a, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
    disablePortraitSquish: 0
  - speakerName: Mycena
    portrait: {fileID: -3118700989449674414, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    talkingPortrait: {fileID: 1879556437470807553, guid: 1f6f0d1b048dff747991882296d65ef3, type: 3}
    text: 'RED ONE FOR PRESIDENT! '
    voiceClip: {fileID: 8300000, guid: b55a99576a2b0f8499fb9e9f7dd61be7, type: 3}
    typewriterSpeedOverride: 0
    fontSizeOverride: 0
